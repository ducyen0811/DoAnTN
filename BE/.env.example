DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/healthai
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=24
# Generate a random secret of at least 32 characters; do not use a password here.
JWT_SECRET=
WEATHER_ENABLED=true
OLLAMA_MODEL=qwen2.5:3b

# Optional: running API origin and device credentials for npm run iot:probe.
# Use your PC's LAN IPv4 address when testing access from another computer.
IOT_BASE_URL=http://127.0.0.1:8000
IOT_DEVICE_ID=
IOT_DEVICE_KEY=
